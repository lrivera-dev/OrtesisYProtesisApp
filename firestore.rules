rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function esPersonal() {
      return autenticado()
        && exists(rutaPerfil())
        && get(rutaPerfil()).data.role == 'personal';
    }

    function esCliente() {
      return autenticado()
        && exists(rutaPerfil())
        && get(rutaPerfil()).data.role == 'cliente';
    }

    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esPersonal());

      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'apellido', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['nombre', 'apellido', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'cliente'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.apellido is string
        && request.resource.data.apellido.size() > 0
        && request.resource.data.apellido.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'apellido', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['nombre', 'apellido', 'email', 'role', 'createdAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'apellido'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.apellido is string
        && request.resource.data.apellido.size() > 0
        && request.resource.data.apellido.size() <= 100;

      allow delete: if false;
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esPersonal();
    }

    match /solicitudes/{solicitudId} {

      function esDuenio() {
        return autenticado() && resource.data.clienteId == request.auth.uid;
      }

      function cambios() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function disponibilidadValida(producto) {
        return (!('disponibilidad' in producto)
            || (producto.disponibilidad is bool && producto.disponibilidad == true))
          && (!('disponible' in producto)
            || (producto.disponible is bool && producto.disponible == true));
      }

      function productoSolicitable(productoId, productoNombre) {
        let rutaProducto = /databases/$(database)/documents/productos/$(productoId);
        return exists(rutaProducto)
          && get(rutaProducto).data.nombre == productoNombre
          && disponibilidadValida(get(rutaProducto).data);
      }

      function camposEditablesValidos(d) {
        return d.tipo in ['producto', 'evaluacion']
          && d.telefono is string
          && d.telefono.matches('^[267][0-9]{3}-[0-9]{4}$')
          && d.descripcion is string
          && d.descripcion.size() >= 20
          && d.descripcion.size() <= 500
          && d.preferenciaHorario is string
          && d.preferenciaHorario.size() <= 150
          && d.fechaPreferida is timestamp
          && d.fechaPreferida > request.time
          && d.productoNombre is string
          && d.productoNombre.size() > 0
          && d.productoNombre.size() <= 150
          && (
            (d.tipo == 'producto'
              && d.productoId is string
              && productoSolicitable(d.productoId, d.productoNombre))
            || (d.tipo == 'evaluacion' && d.productoId == null)
          );
      }

      function transicionValida(de, a) {
        let flujo = {
          'Pendiente': ['Propuesta enviada', 'Cita confirmada', 'Cancelada'],
          'Propuesta enviada': ['Cancelada'],
          'Cita confirmada': ['Atendida', 'Cancelada'],
          'Atendida': [],
          'Cancelada': []
        };
        return (de == 'Propuesta enviada' && a == de)
          || (de in flujo && a in flujo[de]);
      }

      function fechaCitaValida(d) {
        return (d.estado == 'Pendiente' && d.fechaCita == null
            && (!('fechaPropuesta' in d) || d.fechaPropuesta == null))
          || (d.estado == 'Propuesta enviada' && d.fechaCita == null
            && d.fechaPropuesta is timestamp && d.fechaPropuesta > request.time)
          || (d.estado == 'Cita confirmada' && d.fechaCita is timestamp && d.fechaCita > request.time
            && ((('fechaPreferida' in d) && d.fechaCita == d.fechaPreferida)
              || (('fechaPropuesta' in d) && d.fechaCita == d.fechaPropuesta)
              || (!('fechaPreferida' in d) && !('fechaPropuesta' in d))))
          || (d.estado == 'Atendida' && d.fechaCita is timestamp && d.fechaCita <= request.time
            && ((('fechaPreferida' in d) && d.fechaCita == d.fechaPreferida)
              || (('fechaPropuesta' in d) && d.fechaCita == d.fechaPropuesta)
              || (!('fechaPreferida' in d) && !('fechaPropuesta' in d))))
          || (d.estado == 'Cancelada' && (d.fechaCita == null || d.fechaCita is timestamp)
            && (!('fechaPropuesta' in d) || d.fechaPropuesta == null || d.fechaPropuesta is timestamp));
      }

      function notaValida(n) {
        return n.keys().hasOnly(['texto', 'autor', 'estado', 'fecha'])
          && n.keys().hasAll(['texto', 'autor', 'estado', 'fecha'])
          && n.texto is string
          && n.texto.size() >= 5
          && n.texto.size() <= 300
          && n.autor is string
          && n.autor.size() <= 100
          && n.estado == request.resource.data.estado
          && n.fecha is timestamp;
      }

      function notasValidas() {
        let antes = resource.data.notas;
        let despues = request.resource.data.notas;
        let agregaNota = despues.size() == antes.size() + 1
          && despues.size() <= 50
          && despues.hasAll(antes)
          && !(despues[despues.size() - 1] in antes)
          && notaValida(despues[despues.size() - 1]);
        return despues == antes || agregaNota;
      }

      function clienteEdita() {
        return esDuenio()
          && resource.data.estado == 'Pendiente'
          && cambios().hasOnly(['tipo', 'productoId', 'productoNombre', 'telefono', 'descripcion', 'preferenciaHorario', 'fechaPreferida', 'estado', 'actualizadoEn'])
          && request.resource.data.estado == 'Pendiente'
          && request.resource.data.actualizadoEn == request.time
          && camposEditablesValidos(request.resource.data);
      }

      function clienteCancela() {
        return esDuenio()
          && resource.data.estado in ['Pendiente', 'Propuesta enviada', 'Cita confirmada']
          && request.resource.data.estado == 'Cancelada'
          && cambios().hasOnly(['estado', 'actualizadoEn'])
          && request.resource.data.actualizadoEn == request.time;
      }

      function clienteAceptaPropuesta() {
        return esDuenio()
          && resource.data.estado == 'Propuesta enviada'
          && resource.data.fechaPropuesta is timestamp
          && resource.data.fechaPropuesta > request.time
          && request.resource.data.estado == 'Cita confirmada'
          && request.resource.data.fechaCita == resource.data.fechaPropuesta
          && request.resource.data.actualizadoEn == request.time
          && cambios().hasOnly(['estado', 'fechaCita', 'actualizadoEn']);
      }

      function clienteProponeOtraFecha() {
        return esDuenio()
          && resource.data.estado == 'Propuesta enviada'
          && request.resource.data.estado == 'Pendiente'
          && request.resource.data.fechaPreferida is timestamp
          && request.resource.data.fechaPreferida > request.time
          && request.resource.data.fechaPropuesta == null
          && request.resource.data.fechaCita == null
          && request.resource.data.actualizadoEn == request.time
          && cambios().hasOnly(['estado', 'fechaPreferida', 'fechaPropuesta', 'fechaCita', 'actualizadoEn']);
      }

      function personalActualiza() {
        return esPersonal()
          && cambios().hasOnly(['estado', 'notas', 'fechaCita', 'fechaPropuesta', 'actualizadoEn'])
          && request.resource.data.actualizadoEn == request.time
          && transicionValida(resource.data.estado, request.resource.data.estado)
          && fechaCitaValida(request.resource.data)
          && (!cambios().hasAny(['fechaCita'])
            || (resource.data.estado == 'Pendiente' && request.resource.data.estado == 'Cita confirmada'))
          && (!cambios().hasAny(['fechaPropuesta']) || request.resource.data.estado == 'Propuesta enviada')
          && (resource.data.estado in ['Pendiente', 'Propuesta enviada', 'Cita confirmada']
            || request.resource.data.fechaCita == resource.data.fechaCita)
          && notasValidas();
      }

      allow read: if esPersonal()
        || (autenticado() && resource.data.clienteId == request.auth.uid);

      allow create: if esCliente()
        && request.resource.data.keys().hasOnly([
          'clienteId', 'clienteNombre', 'clienteEmail', 'tipo', 'productoId', 'productoNombre',
          'telefono', 'descripcion', 'preferenciaHorario', 'fechaPreferida', 'fechaPropuesta',
          'estado', 'fechaCita', 'notas', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.keys().hasAll([
          'clienteId', 'clienteNombre', 'clienteEmail', 'tipo', 'productoId', 'productoNombre',
          'telefono', 'descripcion', 'preferenciaHorario', 'fechaPreferida', 'fechaPropuesta',
          'estado', 'fechaCita', 'notas', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.clienteEmail == request.auth.token.email
        && request.resource.data.clienteNombre is string
        && request.resource.data.clienteNombre.size() > 0
        && request.resource.data.clienteNombre.size() <= 100
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.fechaPreferida is timestamp
        && request.resource.data.fechaPreferida > request.time
        && request.resource.data.fechaPropuesta == null
        && request.resource.data.fechaCita == null
        && request.resource.data.notas == []
        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn == request.time
        && camposEditablesValidos(request.resource.data);

      allow update: if clienteEdita() || clienteCancela() || clienteAceptaPropuesta()
        || clienteProponeOtraFecha() || personalActualiza();

      allow delete: if (esDuenio() && resource.data.estado in ['Pendiente', 'Cancelada', 'Atendida'])
        || (esPersonal() && resource.data.estado == 'Cancelada');
    }
  }
}